@baseUrl = http://127.0.0.1:8000/api/users

### Create User
POST http://127.0.0.1:8000/api/users
Content-Type: application/json
Accept: application/json

{
    "name": "Palash",
    "email": "Palash@example.com",
    "username": "palash",
    "password": "Palash1911@example.com",
    "password_confirmation": "Palash1911@example.com",
    "phone": "9876543210",
    "address": "Howrah",
    "bio": "Software Developer",
    "type": "superadmin",
    "status": "active"
}




